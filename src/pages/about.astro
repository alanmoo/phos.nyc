---
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";

import Layout from "@/layouts/Layout.astro";
import { SITE } from "@/config";
---

<Layout title={`About | ${SITE.title}`}>
  <Header />
  <main id="main-content" class="app-layout">
    <section id="about" class="app-prose mt-10 mb-8 max-w-app prose-img:border-0">
      <h1 class="text-2xl tracking-wider sm:text-3xl">About</h1>

      <div class="flex flex-col-reverse gap-8 sm:flex-row sm:items-center not-prose">
        <div class="sm:w-1/2">
          <p class="text-xl leading-relaxed">
            <strong>Prospect Heights Open Streets, Inc.</strong> is a new 501(c)(3) nonprofit organization and the community partner operating Vanderbilt Open Streets in 2026.
          </p>
          <p class="text-xl leading-relaxed mt-4">
            We are a volunteer-based organization.
          </p>
        </div>
        <div class="sm:w-1/2 flex justify-center">
          <img src="/images/phos-logo-full-transparent.png" alt="Prospect Heights Open Streets logo" class="w-full rounded-lg border-0" />
        </div>
      </div>

    </section>
  </main>

  <div class="w-full bg-[#f5f5f0] py-12">
    <div class="app-layout flex flex-col gap-8 sm:flex-row sm:items-center">
      <div class="sm:w-1/2">
        <img src="/images/vanderbilt-photos/2.jpg" alt="Community gathering on Vanderbilt Open Streets" class="w-full rounded-lg border-0" />
      </div>
      <div class="sm:w-1/2">
        <h2 class="text-2xl font-bold tracking-wider mb-4 font-heading">Our Mission</h2>
        <p class="text-xl leading-relaxed">
          Our mission is to make streets in Prospect Heights safer, more livable, and accessible for residents of all ages, by organizing public space activation programs and advocating for inclusive, people-centered public spaces.
        </p>
      </div>
    </div>
  </div>

  <main class="app-layout">
    <section class="mb-28 max-w-app">
      <h2 class="text-2xl font-bold tracking-wider mb-6 font-heading mt-12">Frequently Asked Questions</h2>

      <p class="text-xl leading-relaxed mb-6"><strong>What is Vanderbilt Open Streets?</strong><br />
      Vanderbilt Open Streets closes Vanderbilt Ave between Atlantic Ave and Park Place to car traffic every Saturday from May through September, noon to 10 pm, creating a pedestrian-friendly space for the community.</p>

      <p class="text-xl leading-relaxed mb-6"><strong>Is this a City program?</strong><br />
      Yes, the <a href="https://www.nyc.gov/html/dot/html/pedestrians/openstreets.shtml" target="_blank" rel="noopener noreferrer" class="text-accent underline">NYC Open Streets program</a> is a NYC Department of Transportation initiative, but each Open Street is operated by a local community partner. Prospect Heights Open Streets, Inc. is the community partner for Vanderbilt Open Streets.</p>

      <p class="text-xl leading-relaxed mb-6"><strong>How can I get involved?</strong><br />
      Visit our <a href="/get-involved" class="text-accent underline">Get Involved</a> page to learn about volunteering, performing, hosting events, sponsoring and donating.</p>
 
      <p class="text-xl leading-relaxed mb-6"><strong>Why do you need money?</strong><br />
      We are an all-volunteer non-profit organization, and the funds we raise pay for staff to help us move barriers and marshal the street, and for performers, artists, and instructors who offer programming. We also need to pay for insurance, permits, printing, signage, and other operational costs.</p>

      <h2 class="text-2xl font-bold tracking-wider mb-6 font-heading mt-12">Restaurant Partners</h2>
      <p class="text-xl leading-relaxed"><em>Coming soon — restaurant partner profiles will be listed here.</em></p>

      <h2 class="text-2xl font-bold tracking-wider mb-6 font-heading mt-12">Sponsors</h2>
      <p class="text-xl leading-relaxed"><em>Coming soon — sponsor information will be listed here.</em></p>
    </section>
  </main>
  <Footer />
</Layout>
