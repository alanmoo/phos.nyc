<Layout title={`In the News | ${SITE.title}`}>
  <Header />
  <main id="main-content" class="app-layout">
    <section class="mt-10 mb-28 max-w-app">
      <h1 class="text-2xl tracking-wider sm:text-3xl font-heading font-bold">In the News</h1>

      <ul class="mt-8 space-y-6">
        {articles.map(article => (
          <li class="border-b border-border pb-6">
            <a
              href={article.url}
              target="_blank"
              rel="noopener noreferrer"
              class="text-xl text-accent underline font-semibold hover:opacity-80"
            >
              {article.title}
              <svg xmlns="http://www.w3.org/2000/svg" class="inline w-4 h-4 ml-1 -mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" /><polyline points="15 3 21 3 21 9" /><line x1="10" y1="14" x2="21" y2="3" /></svg>
            </a>
            <div class="mt-1 text-foreground/70">
              {article.outlet}{article.outlet && " \u00B7 "}{article.date}
            </div>
          </li>
        ))}
      </ul>
    </section>
  </main>
  <Footer />
</Layout>
