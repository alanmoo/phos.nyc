---
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";

import Layout from "@/layouts/Layout.astro";
import { SITE } from "@/config";
---

<Layout title={`Get Involved | ${SITE.title}`}>
  <Header />
  <main id="main-content" class="app-layout">
    <section class="mt-10 mb-28 max-w-app">
      <h1 class="text-2xl tracking-wider sm:text-3xl font-heading font-bold">Get Involved</h1>

      <p class="text-xl leading-relaxed mt-6">There are many ways to support Prospect Heights Open Streets and help make our neighborhood streets safer and more livable.</p>

      <h2 class="text-2xl font-bold tracking-wider mb-4 font-heading mt-12">Volunteer</h2>
      <p class="text-xl leading-relaxed">We need volunteers to help run the program. Tasks range from behind-the-scenes organizing to moving barriers on the street. <a href="https://forms.gle/o2xVSV1ZK3zdt3mj9" target="_blank" rel="noopener noreferrer" class="text-accent underline font-semibold">Sign up to volunteer!</a></p>

      <h2 class="text-2xl font-bold tracking-wider mb-4 font-heading mt-12">Perform or Host an Event</h2>
      <p class="text-xl leading-relaxed">Want to perform music, lead an activity, or host a community event on the Open Street? <a href="https://forms.gle/LPo2PivCaC25pCpM7" target="_blank" rel="noopener noreferrer" class="text-accent underline font-semibold">Fill out the event application form!</a></p>

      <h2 class="text-2xl font-bold tracking-wider mb-4 font-heading mt-12">Donate</h2>
      <p class="text-xl leading-relaxed">Your donation helps us keep Vanderbilt Open Streets running and free for everyone. <a href="https://givebutter.com/vanderbilt-avenue-open-street-is-back-for-2026-xpedp3" target="_blank" rel="noopener noreferrer" class="text-accent underline font-semibold">Donate via Givebutter!</a></p>

      <h2 class="text-2xl font-bold tracking-wider mb-4 font-heading mt-12">Sponsor</h2>
      <p class="text-xl leading-relaxed">Reach out to learn about sponsorship opportunities! Contact us at <a href="mailto:info@phos.nyc" class="text-accent underline font-semibold">info@phos.nyc</a>.</p>

      <h2 class="text-2xl font-bold tracking-wider mb-4 font-heading mt-12">Sign the Petition</h2>
      <p class="text-xl leading-relaxed">Support safer streets in Prospect Heights by <a href="https://act.transalt.org/a/prospectheightsstreets" target="_blank" rel="noopener noreferrer" class="text-accent underline font-semibold">signing the Streets for People petition!</a></p>

      <h2 class="text-2xl font-bold tracking-wider mb-4 font-heading mt-12">Contact Us</h2>
      <p class="text-xl leading-relaxed">Have a question or want to share feedback? Contact us at <a href="mailto:info@phos.nyc" class="text-accent underline font-semibold">info@phos.nyc</a>.</p>
    </section>
  </main>
  <Footer />
</Layout>
